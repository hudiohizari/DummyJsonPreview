<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.DummyJsonPreview" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Matches the Compose background so there is no flash before the first frame. -->
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Applied to the activity so the system splash covers the session lookup on cold start. -->
    <style name="Theme.DummyJsonPreview.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="postSplashScreenTheme">@style/Theme.DummyJsonPreview</item>
    </style>
</resources>
